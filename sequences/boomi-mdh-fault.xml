<!--
  Handles mediation-level faults (connection refused, timeout, DNS, etc.).
  NOTE: a Boomi 4xx/5xx is NOT a mediation fault - the <call> mediator returns it as a
  normal response and the API layer passes the Boomi status + <error> body straight
  through. This sequence only fires when the HTTP call itself could not complete.
-->
<sequence name="boomi-mdh-fault"
    xmlns="http://ws.apache.org/ns/synapse">
    <property name="HTTP_SC" value="502" scope="axis2"/>
    <payloadFactory media-type="xml">
        <format>
            <error xmlns="">
                <source>boomi-mdh-connector</source>
                <message>$1</message>
                <detail>$2</detail>
            </error>
        </format>
        <args>
            <arg expression="$ctx:ERROR_MESSAGE"/>
            <arg expression="$ctx:ERROR_DETAIL"/>
        </args>
    </payloadFactory>
    <property name="messageType" value="application/xml" scope="axis2"/>
    <property name="ContentType" value="application/xml" scope="axis2"/>
    <respond/>
</sequence>
