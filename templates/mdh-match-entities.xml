<!--
  Boomi DataHub (MDH) :: Match Entities
  ========================================
  POST {hubBaseUrl}/universes/{universeId}/match
  Runs the model's match rules against a batch of source entities WITHOUT staging them,
  returning potential matches/duplicates per entity. Ideal for de-dup checks against
  golden records before contributing.

  REQUEST BODY: the current message MUST already be the <batch src="..."> payload, e.g.
    <batch src="CRM_SYSTEM">
      <contact><id>1</id><name>bobby</name><email>bob@gmail.com</email></contact>
      <contact><id>2</id><name>mike</name><email>mike@gmail.com</email></contact>
    </batch>
  Response: <MatchEntitiesResponse> with a <MatchResult status="..."> per entity
  (SUCCESS / DUPLICATE / TOO_MANY_MATCHES / ALREADY_LINKED / MATCH_REFERENCE_FAILURE / ...),
  each containing the echoed <entity>, plus <match>/<duplicate> (and <fuzzyMatchDetails>).

  Params:
    hubBaseUrl               (req) e.g. https://c01-usa-east.hub.boomi.com/mdm
    universeId               (req) universe (domain) UUID
    authorization            (req) "Basic <base64(user:token)>" or "Bearer <jwt>"
    repositoryId             (opt) JWT/bearer auth only
    ambiguousMatchSampleSize (opt) sample count returned on TOO_MANY_MATCHES (fuzzy diagnostics)
-->
<template name="mdh-match-entities"
    xmlns="http://ws.apache.org/ns/synapse">
    <parameter name="hubBaseUrl"/>
    <parameter name="universeId"/>
    <parameter name="authorization"/>
    <parameter name="repositoryId"/>
    <parameter name="ambiguousMatchSampleSize"/>
    <sequence>
        <property name="uri.var.hubBaseUrl" expression="$func:hubBaseUrl"/>
        <property name="uri.var.universeId" expression="$func:universeId"/>

        <filter xpath="string-length(normalize-space($func:repositoryId)) &gt; 0">
            <then>
                <property name="uri.var.repositoryId" expression="$func:repositoryId"/>
            </then>
        </filter>
        <filter xpath="string-length(normalize-space($func:ambiguousMatchSampleSize)) &gt; 0">
            <then>
                <property name="uri.var.ambiguousMatchSampleSize" expression="$func:ambiguousMatchSampleSize"/>
            </then>
        </filter>

        <property name="Authorization" expression="$func:authorization" scope="transport"/>
        <property name="Accept" value="application/xml" scope="transport"/>
        <property name="messageType" value="application/xml" scope="axis2"/>
        <property name="ContentType" value="application/xml" scope="axis2"/>
        <property name="HTTP_METHOD" value="POST" scope="axis2"/>
        <property name="REST_URL_POSTFIX" scope="axis2" action="remove"/>

        <call>
            <endpoint>
                <http method="post" uri-template="{+uri.var.hubBaseUrl}/universes/{uri.var.universeId}/match{?uri.var.repositoryId,uri.var.ambiguousMatchSampleSize}">
                    <timeout>
                        <duration>60000</duration>
                        <responseAction>fault</responseAction>
                    </timeout>
                    <suspendOnFailure>
                        <initialDuration>-1</initialDuration>
                        <progressionFactor>1</progressionFactor>
                        <maximumDuration>0</maximumDuration>
                    </suspendOnFailure>
                    <markForSuspension>
                        <errorCodes>-1</errorCodes>
                        <retriesBeforeSuspension>0</retriesBeforeSuspension>
                    </markForSuspension>
                </http>
            </endpoint>
        </call>
    </sequence>
</template>
