<!--
  Boomi DataHub (MDH) :: Get Golden Record
  ========================================
  GET {hubBaseUrl}/universes/{universeId}/records/{recordId}
  Returns the golden-record entity XML (root element = universe name, with
  grid/createddate/updateddate/source attributes) or a Boomi <error>.

  Params:
    hubBaseUrl            (req) e.g. https://c01-usa-east.hub.boomi.com/mdm  (no trailing slash)
    universeId            (req) universe (domain) UUID
    recordId              (req) golden record UUID
    authorization         (req) full header value: "Basic <base64(user:token)>" or "Bearer <jwt>"
    repositoryId          (opt) required for JWT/bearer auth only; omit for basic auth
    includeReferenceTitle (opt) "true" to include recordTitle for resolved reference fields
-->
<template name="mdh-get-golden-record"
    xmlns="http://ws.apache.org/ns/synapse">
    <parameter name="hubBaseUrl"/>
    <parameter name="universeId"/>
    <parameter name="recordId"/>
    <parameter name="authorization"/>
    <parameter name="repositoryId"/>
    <parameter name="includeReferenceTitle"/>
    <sequence>
        <property name="uri.var.hubBaseUrl" expression="$func:hubBaseUrl"/>
        <property name="uri.var.universeId" expression="$func:universeId"/>
        <property name="uri.var.recordId" expression="$func:recordId"/>

        <!-- optional query params: set the uri.var only when a value was supplied -->
        <filter xpath="string-length(normalize-space($func:repositoryId)) &gt; 0">
            <then>
                <property name="uri.var.repositoryId" expression="$func:repositoryId"/>
            </then>
        </filter>
        <filter xpath="string-length(normalize-space($func:includeReferenceTitle)) &gt; 0">
            <then>
                <property name="uri.var.includeReferenceTitle" expression="$func:includeReferenceTitle"/>
            </then>
        </filter>

        <property name="Authorization" expression="$func:authorization" scope="transport"/>
        <property name="Accept" value="application/xml" scope="transport"/>
        <property name="HTTP_METHOD" value="GET" scope="axis2"/>
        <property name="NO_ENTITY_BODY" value="true" scope="axis2" type="BOOLEAN"/>
        <property name="REST_URL_POSTFIX" scope="axis2" action="remove"/>

        <call>
            <endpoint>
                <http method="get" uri-template="{+uri.var.hubBaseUrl}/universes/{uri.var.universeId}/records/{uri.var.recordId}{?uri.var.repositoryId,uri.var.includeReferenceTitle}">
                    <timeout>
                        <duration>60000</duration>
                        <responseAction>fault</responseAction>
                    </timeout>
                    <suspendOnFailure>
                        <initialDuration>-1</initialDuration>
                        <progressionFactor>1</progressionFactor>
                        <maximumDuration>0</maximumDuration>
                    </suspendOnFailure>
                    <markForSuspension>
                        <errorCodes>-1</errorCodes>
                        <retriesBeforeSuspension>0</retriesBeforeSuspension>
                    </markForSuspension>
                </http>
            </endpoint>
        </call>
    </sequence>
</template>
