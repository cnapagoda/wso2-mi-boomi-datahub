<!--
  Boomi DataHub (MDH) :: Query Golden Records
  ========================================
  POST {hubBaseUrl}/universes/{universeId}/records/query
  Returns <RecordQueryResponse resultCount totalCount offsetToken> with <Record> children
  (active golden records only). Page with the returned offsetToken.

  REQUEST BODY: the current message MUST already be the <RecordQueryRequest> payload, e.g.
    <RecordQueryRequest limit="200" includeSourceLinks="true">
      <filter op="AND">
        <fieldValue><fieldId>EMAIL</fieldId><operator>EQUALS</operator><value>a@b.com</value></fieldValue>
      </filter>
      <sort><sortField><fieldId>@updatedDate</fieldId><direction>DESC</direction></sortField></sort>
    </RecordQueryRequest>

  Params:
    hubBaseUrl            (req) e.g. https://c01-usa-east.hub.boomi.com/mdm
    universeId            (req) universe (domain) UUID
    authorization         (req) "Basic <base64(user:token)>" or "Bearer <jwt>"
    repositoryId          (opt) JWT/bearer auth only
    includeReferenceTitle (opt) "true" to add recordTitle for resolved reference fields
-->
<template name="mdh-query-golden-records"
    xmlns="http://ws.apache.org/ns/synapse">
    <parameter name="hubBaseUrl"/>
    <parameter name="universeId"/>
    <parameter name="authorization"/>
    <parameter name="repositoryId"/>
    <parameter name="includeReferenceTitle"/>
    <sequence>
        <property name="uri.var.hubBaseUrl" expression="$func:hubBaseUrl"/>
        <property name="uri.var.universeId" expression="$func:universeId"/>

        <filter xpath="string-length(normalize-space($func:repositoryId)) &gt; 0">
            <then>
                <property name="uri.var.repositoryId" expression="$func:repositoryId"/>
            </then>
        </filter>
        <filter xpath="string-length(normalize-space($func:includeReferenceTitle)) &gt; 0">
            <then>
                <property name="uri.var.includeReferenceTitle" expression="$func:includeReferenceTitle"/>
            </then>
        </filter>

        <property name="Authorization" expression="$func:authorization" scope="transport"/>
        <property name="Accept" value="application/xml" scope="transport"/>
        <property name="messageType" value="application/xml" scope="axis2"/>
        <property name="ContentType" value="application/xml" scope="axis2"/>
        <property name="HTTP_METHOD" value="POST" scope="axis2"/>
        <property name="REST_URL_POSTFIX" scope="axis2" action="remove"/>

        <call>
            <endpoint>
                <http method="post" uri-template="{+uri.var.hubBaseUrl}/universes/{uri.var.universeId}/records/query{?uri.var.repositoryId,uri.var.includeReferenceTitle}">
                    <timeout>
                        <duration>60000</duration>
                        <responseAction>fault</responseAction>
                    </timeout>
                    <suspendOnFailure>
                        <initialDuration>-1</initialDuration>
                        <progressionFactor>1</progressionFactor>
                        <maximumDuration>0</maximumDuration>
                    </suspendOnFailure>
                    <markForSuspension>
                        <errorCodes>-1</errorCodes>
                        <retriesBeforeSuspension>0</retriesBeforeSuspension>
                    </markForSuspension>
                </http>
            </endpoint>
        </call>
    </sequence>
</template>
