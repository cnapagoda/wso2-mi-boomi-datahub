<!--
  Boomi DataHub (MDH) :: Get Batch Update Status
  ==============================================
  GET {hubBaseUrl}/universes/{universeId}/records/updates/{batchId}
  Retrieves the status of a batch update (the async companion to Update Golden Records / Update
  Golden Records (Stage)). After an async update returns 202, take the last path segment of the
  returned batch-update URL as the batchId and poll this until <state> reaches a terminal value
  (COMPLETED, COMPLETED_ERRORS, or ERRORED).

  The response <batch> carries counts (entityCount, createdCount, updatedCount, deletedCount,
  quarantinedCount) and, when includeEntities=true, a per-entity <entities> breakdown including
  each entity's <state>/<stateDetail> and quarantine <message>.

  Params:
    hubBaseUrl      (req) e.g. https://c01-usa-east.hub.boomi.com/mdm
    universeId      (req) universe (domain) UUID
    batchId         (req) batch update id (last segment of the 202 batch-update URL)
    authorization   (req) "Basic <base64(user:token)>" or "Bearer <jwt>"
    repositoryId    (opt) JWT/bearer auth only
    includeEntities (opt) "true" to include per-entity status; "false" (default) batch status only
-->
<template name="mdh-get-batch-update-status"
    xmlns="http://ws.apache.org/ns/synapse">
    <parameter name="hubBaseUrl"/>
    <parameter name="universeId"/>
    <parameter name="batchId"/>
    <parameter name="authorization"/>
    <parameter name="repositoryId"/>
    <parameter name="includeEntities"/>
    <sequence>
        <property name="uri.var.hubBaseUrl" expression="$func:hubBaseUrl"/>
        <property name="uri.var.universeId" expression="$func:universeId"/>
        <property name="uri.var.batchId" expression="$func:batchId"/>

        <filter xpath="string-length(normalize-space($func:repositoryId)) &gt; 0">
            <then>
                <property name="uri.var.repositoryId" expression="$func:repositoryId"/>
            </then>
        </filter>
        <filter xpath="string-length(normalize-space($func:includeEntities)) &gt; 0">
            <then>
                <property name="uri.var.includeEntities" expression="$func:includeEntities"/>
            </then>
        </filter>

        <property name="Authorization" expression="$func:authorization" scope="transport"/>
        <property name="Accept" value="application/xml" scope="transport"/>
        <property name="HTTP_METHOD" value="GET" scope="axis2"/>
        <property name="NO_ENTITY_BODY" value="true" scope="axis2" type="BOOLEAN"/>
        <property name="REST_URL_POSTFIX" scope="axis2" action="remove"/>

        <call>
            <endpoint>
                <http method="get" uri-template="{+uri.var.hubBaseUrl}/universes/{uri.var.universeId}/records/updates/{uri.var.batchId}{?uri.var.repositoryId,uri.var.includeEntities}">
                    <timeout>
                        <duration>60000</duration>
                        <responseAction>fault</responseAction>
                    </timeout>
                    <suspendOnFailure>
                        <initialDuration>-1</initialDuration>
                        <progressionFactor>1</progressionFactor>
                        <maximumDuration>0</maximumDuration>
                    </suspendOnFailure>
                    <markForSuspension>
                        <errorCodes>-1</errorCodes>
                        <retriesBeforeSuspension>0</retriesBeforeSuspension>
                    </markForSuspension>
                </http>
            </endpoint>
        </call>
    </sequence>
</template>
